{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "audit:world": "node scripts/check-world-quality.mjs",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "cesium": "1.145.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vite-plugin-static-copy": "4.1.1"
  }
}
