<WMT_MS_Capabilities version="1.1.1">
<Service>
  <Name>OGC:WMS</Name>
  <Title>Geoscopio_wms OFC_RT</Title>
  <Abstract>Servizio OGC di tipo WMS fornito da Regione Toscana-SIPT (Settore Sistema Informativo e Pianificazione del Territorio) dedicato specificamente alla consultazione delle ortofoto 2021,2023, 2024/2025. Le ortofoto, che coprono l’intero territorio regionale, hanno un GSD pari a 20 cm e provengono dall’elaborazione di fotogrammi ottenuti tramite voli realizzati ad una quota media pari a 2700 mslm.</Abstract>
  <KeywordList>
      <Keyword>ortofotocarta</Keyword>
      <Keyword>foto</Keyword>
  </KeywordList>
  <OnlineResource xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www502.regione.toscana.it/ows_ofc/com.rt.wms.RTmap/wms?map=owsofc_rt&amp;"/>
  <ContactInformation>
    <ContactPersonPrimary>
      <ContactPerson>Sistema informativo e Pianificazione del territorio</ContactPerson>
      <ContactOrganization>Regione Toscana - Direzione Urbanistica</ContactOrganization>
    </ContactPersonPrimary>
      <ContactPosition>custodian</ContactPosition>
    <ContactAddress>
        <AddressType>postal</AddressType>
        <Address>Via di Novoli, 26</Address>
        <City>Firenze</City>
        <StateOrProvince>Regione Toscana</StateOrProvince>
        <PostCode>50127</PostCode>
        <Country>Italy</Country>
    </ContactAddress>
  <ContactElectronicMailAddress>infrastruttura.geografica@regione.toscana.it</ContactElectronicMailAddress>
  </ContactInformation>
  <Fees>none</Fees>
  <AccessConstraints>none</AccessConstraints>
</Service>

